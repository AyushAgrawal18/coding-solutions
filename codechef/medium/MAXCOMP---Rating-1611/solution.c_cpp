#include <bits/stdc++.h>
using namespace std;

#define fastio() ios::sync_with_stdio(0); cin.tie(0); cout.tie(0)
#define ll long long

inline void solve() {
    int n;
    cin >> n;

    vector<array<ll, 3>> a(n);
    for (int i = 0; i < n; i++) {
        cin >> a[i][0] >> a[i][1] >> a[i][2];
    }

    sort(a.begin(), a.end(), [](auto &x, auto &y) {
        return x[1] < y[1];
    });

    vector<ll> dp(n);

    for (int i = 0; i < n; i++) {
        ll take = a[i][2];

        int l = 0, r = i - 1;
        int prev = -1;

        while (l <= r) {
            int mid = (l + r) / 2;

            if (a[mid][1] <= a[i][0]) {
                prev = mid;
                l = mid + 1;
            } else {
                r = mid - 1;
            }
        }

        if (prev != -1)
            take += dp[prev];
        ll not_take = (i == 0 ? 0 : dp[i - 1]);

        dp[i] = max(take, not_take);
    }

    cout << dp[n - 1] << '\n';
}

int main() {
    fastio();

    int t;
    cin >> t;

    while (t--)
        solve();

    return 0;
}