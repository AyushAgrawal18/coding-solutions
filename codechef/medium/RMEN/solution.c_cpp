#define no() cout << "NO\n"

typedef vector<int> vi;
typedef vector<char> vll;
typedef pair<int, int> pii;
typedef vector<pii> vpii;

const ll MOD = 1e9 + 7;
const ll INF = 1e18;
const double PI = acos(-1);



inline void solve() {
    // Your solution goes here
    string s;
    cin>>s;
    string ans;
    for (int i=0;i<s.size();i++){
    if (s[i]=='#') continue;
    if(i+1<(int)s.size()&&s[i+1]=='#'){
        ans+=char('z'-(s[i]-'o'));
        i++;
    }
    else{
        ans+=char('n'-(s[i]-'a'));
    }
}
    cout<<ans;
    cout<<endl;
}

