        pos.pb({i+a[i],i});
        if(a[i]==i) cnt++;
        pref[i]=pref[i-1]+(a[i]==1);
    }
    sort(all(pos));
    ll ans=cnt;
    for(int i=1;i<=n;i++){
        ll l=min(a[i],i);
        ll r=max(a[i],i);
        ll x=i+a[i];
        
        ll low=lower_bound(all(pos),make_pair(s,l));
        ll high=upper_bound(all(pos),make_pair(s,r));
        
        ll count=high-low;
