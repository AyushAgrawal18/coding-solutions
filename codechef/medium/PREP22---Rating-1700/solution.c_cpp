#define ll long long
long long largestRectangleArea(int n, vector<int>& a) {
    //write your code here
    stack<int> st;
    ll ans = 0;

    for (int i = 0; i <= n; i++) {
        int curr = (i==n?0:a[i]);
        while (!st.empty() && a[st.top()] > curr) {
            int height = a[st.top()];
            st.pop();
            int width;
            if (st.empty())
                width = i;
            else
                width = i-st.top()-1;
            ans = max(ans, 1LL * height * width);
        }
        st.push(i);
    }
    return ans;
}