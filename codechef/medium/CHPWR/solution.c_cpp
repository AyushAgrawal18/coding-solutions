#include <bits/stdc++.h>
using namespace std;

#define fastio() ios::sync_with_stdio(0); cin.tie(0); cout.tie(0)

inline void solve() {
    int P, R, C;
    cin >> P >> R >> C;

    vector<vector<double>> dp(101, vector<double>(101, 0.0));

    dp[0][0] = P;

    for (int i = 0; i < R; i++) {
        for (int j = 0; j <= i; j++) {

            if (dp[i][j] > 1.0) {
                double excess = dp[i][j] - 1.0;

                dp[i][j] = 1.0;

                dp[i + 1][j] += excess / 2.0;
                dp[i + 1][j + 1] += excess / 2.0;
            }
        }
    }

    cout << fixed << setprecision(5) << min(1.0, dp[R][C]) << '\n';
}

int main() {
    fastio();
    solve();
    return 0;
}