#include <bits/stdc++.h>
using namespace std;

#define fastio() ios::sync_with_stdio(0); cin.tie(0); cout.tie(0)

inline void solve() {
    int p, r, c;
    cin >> p >> r >> c;

    vector<vector<double>> dp(r + 2, vector<double>(r + 2, 0));

    dp[0][0] = p;

    for (int i = 0; i < r; i++) {
        for (int j = 0; j <= i; j++) {

            if (dp[i][j] > 1.0) {
                double overflow = dp[i][j] - 1.0;

                dp[i][j] = 1.0;

                dp[i + 1][j] += overflow / 2.0;
                dp[i + 1][j + 1] += overflow / 2.0;
            }
        }
    }

    cout << fixed << setprecision(5) << dp[r][c];
}

int main() {
    fastio();
    solve();
    return 0;
}